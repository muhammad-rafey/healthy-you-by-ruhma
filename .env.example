# Public site URL — used by sitemap, OG images, canonical tags. Set per environment in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (server-side email for the /contact form). Get a key at resend.com.
RESEND_API_KEY=
# Inbox that receives contact-form submissions. Comma-separate for multiple.
RESEND_TO_EMAIL=hello@dietitianruhma.com
# "From" address. Must be on a domain verified in Resend. Until dietitianruhma.com
# is verified there, the shared test sender below works (test mode only
# delivers to the Resend account owner). Production: "Healthy You <noreply@dietitianruhma.com>".
RESEND_FROM_EMAIL=Healthy You <onboarding@resend.dev>

# Plausible (client analytics). Plan #13 wires this up.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Vercel Analytics requires no key (it's auto-injected on Vercel).

# MongoDB for the /blog section. Local dev uses the same mongod Compass connects to.
# Production: replace with a MongoDB Atlas SRV URI before deploying to Vercel.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=healthy-you-by-ruhma

# Password for the /admin login. Choose a long, random string.
ADMIN_PASSWORD=change-me
